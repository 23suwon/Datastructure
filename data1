#include <stdio.h>

int main() {
	//과제 1번
    int a = -5;
	unsigned int b = (unsigned int)a; // a를 unsigned int로 변환하여 b에 저장합니다

    if (b == 0xFFFFFFFB) {
		printf("2의 보수입니다. \n"); //16진수 0xFFFFFFFB는 2의 보수 표현에서 -5를 나타내기때문에 b의값과 같은지 비교해서 출력합니다
    }
    else if (b == 0xFFFFFFFA) {
		printf("1의 보수입니다.\n"); //16진수 0xFFFFFFFA는 1의 보수 표현에서 -5를 나타내기때문에 b의값과 같은지 비교해서 출력합니다
    }
    //과제 2번
    float input;
    printf("입력:\n");  
    scanf_s("%f", &input);

    int fixed = (int)(input * 256);
    unsigned short u_fixed = (unsigned short)fixed;

    for (int i = 15; i >= 8; i--) {
        printf("%d", (u_fixed >> i) & 1);
    }
    printf(".");
    for (int i = 7; i >= 0; i--) {
        printf("%d", (u_fixed >> i) & 1);
    }
    printf("\n");

    return 0;
}
